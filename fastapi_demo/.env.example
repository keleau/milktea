# 复制为 fastapi_demo/.env 后填写真实密码；.env 不会被提交
# 不设置 DATABASE_URL 时，默认使用 fastapi_demo/database/milktea.db（SQLite）

# 使用 MySQL（先在 Navicat 中导入 database/schema_mysql.sql）；不用 MySQL 就保持注释
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/milktea?charset=utf8mb4

# 可选：打印 SQL 方便调试
# SQL_ECHO=1

# 可选：接口返回的静态资源绝对地址前缀
# BASE_URL=http://127.0.0.1:8000

# 微信小程序真实登录 + 生成桌码小程序码：AppID 与 AppSecret 都填写后才会调用微信接口
# AppSecret 只能放后端，不要写进前端、聊天或提交仓库
# WECHAT_APPID=wx...
# WECHAT_SECRET=...

# 店员核销口令：店员在小程序「我的 → 店员核销」里输入，用于取餐核销
# 留空则核销接口不可用；不要用简单口令，也不要提交真实值
# STAFF_PIN=请改成6位随机数字

# AI 点单助手：DeepSeek Chat（OpenAI 兼容接口）
# 只放后端，不要写进前端或提交仓库；留空时 /ai/chat 返回“暂未配置”
# DEEPSEEK_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# AI_MIN_INTERVAL_SECONDS=2

# 待支付订单超时自动取消（分钟）；后台每 60 秒扫描一次
# ORDER_EXPIRY_MINUTES=15
# ORDER_EXPIRY_INTERVAL_SECONDS=60
