# 复制为 fastapi_demo/.env 后填写真实密码；.env 不会被提交
# 不设置 DATABASE_URL 时，默认使用 fastapi_demo/database/milktea.db（SQLite）

# 使用 MySQL（先在 Navicat 中导入 database/schema_mysql.sql）
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/milktea?charset=utf8mb4

# 可选：打印 SQL 方便调试
# SQL_ECHO=1

# 可选：接口返回的静态资源绝对地址前缀
# BASE_URL=http://127.0.0.1:8000
